  "narrative": {
    "northStar": "The Familiar Player",
    "overview": "syng looks and behaves like the streaming apps people already use, on purpose, so nobody has to learn anything. It sits next to Spotify, Apple Music and YouTube Music without borrowing any one of them, because the queue belongs to no single service.",
    "keyCharacteristics": [
      "Every song shows whose pick it is and which account it plays from.",
      "One yellow accent, used only as a fill under dark text.",
      "Flat neutral layers; depth from tone, not shadow.",
      "Services named in text, never with logos or brand colors."
    ],
    "rules": [
      {
        "name": "The Fill Rule",
        "body": "Yellow is never text, a border or an outline. It is a fill with dark text on it.",
        "section": "colors"
      },
      {
        "name": "The No Service Color Rule",
        "body": "Nothing uses a streaming service's brand color or mark.",
        "section": "colors"
      },
      {
        "name": "The Tint Rule",
        "body": "The now-playing card mixes 18% of the cover hue into Layer 1; text inside uses Text and Text 2 only.",
        "section": "colors"
      },
      {
        "name": "The Fixed Scale Rule",
        "body": "Type sizes are fixed rem steps; only the big screen scales with the viewport.",
        "section": "typography"
      },
      {
        "name": "The Flat Rule",
        "body": "Cards, rows and buttons never have shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show the picker and the source account on every song.",
      "Do name the visitor's own app in the add action.",
      "Do keep one yellow primary action per view.",
      "Do pair every color-coded state with a shape or text change."
    ],
    "donts": [
      "Don't use streaming service logos or brand colors.",
      "Don't use yellow for text, borders or decoration.",
      "Don't add shadows to cards, rows or buttons.",
      "Don't add explanatory banners to the room.",
      "Don't claim integrations or availability that do not exist."
    ]
  }
