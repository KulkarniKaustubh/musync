<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.syng"
    android:versionCode="2"
    android:versionName="0.2.0">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <!-- Serves the room to phones on the same Wi-Fi and reaches the music catalogs. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Rooms are served over plain http on the local network, so cleartext must be allowed. -->
    <application
        android:label="syng"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">
        <activity
            android:name=".android.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
