<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.musync"
    android:versionCode="11"
    android:versionName="0.6.1">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="33" />

    <!-- Serves the room to phones on the same Wi-Fi and reaches the music catalogs. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reads this phone's Wi-Fi address so the invite link points at it. No location, no network names. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Keeps the room and the music going while musync is minimised, with a notification saying so. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The music apps musync can start songs in. Android hides other apps unless they are listed. -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="com.amazon.mp3" />
        <package android:name="deezer.android.app" />
        <package android:name="com.soundcloud.android" />
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <!-- Rooms are served over plain http on the local network, so cleartext must be allowed. -->
    <application
        android:label="musync"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">
        <activity
            android:name=".android.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".android.PlaybackService" android:exported="false" />

        <!-- Lets the user grant "notification access", which Android requires before one app
             may control another app's playback. musync does not read notifications. -->
        <service
            android:name=".android.MediaAccessService"
            android:label="musync playback control"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
